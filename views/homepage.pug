doctype html
html
    head
        title= title
        meta(name="viewport" content="width=device-width, initial-scale=1")
        link(rel="stylesheet", href="/css/style.css")
    body
        a(href="/update-cobj") Add to this table
        h1 Theranos
        table
            thead
                tr
                    th Name
                    th Investment
                    th Known for
            tbody
                each record in data
                    tr
                        td= record.properties.name
                        td= record.properties.investment
                        td= record.properties.known_for
